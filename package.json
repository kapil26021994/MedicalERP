{
  "name": "shop-inventory-and-billing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "ng serve --host 0.0.0.0 --port 3000 --proxy-config proxy.conf.json",
    "api": "npm run build && node --env-file-if-exists=.env api.ts",
    "start": "node --env-file-if-exists=.env server.ts",
